# Copy to configs/livekit.local.env and edit locally.
# This file is gitignored.

BOARD=lichuang_esp32s3
PROFILE=dev

AUTH_MODE=token_server

TOKEN_SERVER_URL=http://YOUR_MAC_IP:8790/token
TOKEN_SERVER_TIMEOUT_MS=5000
TOKEN_SERVER_RETRY_DELAY_MS=3000
TOKEN_SERVER_AUTH_MAX_FAILURES=3

LIVEKIT_ROOM=lichuang-room
LIVEKIT_PARTICIPANT=lichuang-esp32s3
LIVEKIT_PARTICIPANT_IDENTITY=lichuang-esp32s3
LIVEKIT_AGENT_NAME=my-agent

# Machine-local debug endpoints. Scenario overlays decide whether to enable them.
DEBUG_UPLINK_WS_URL=ws://YOUR_MAC_IP:8765/uplink
DEBUG_DOWNLINK_WS_URL=ws://YOUR_MAC_IP:8765/downlink
DEBUG_UPLINK_WS_RECONNECT_MS=3000
DEBUG_HTTP_PORT=8080

# Use SCENARIO=dev-token / dev-uplink-ws / dev-audio-ws / prod-standby / release-token
# when running scripts/project.sh or scripts/package_firmware.sh.
# Keep the real configs/livekit.local.env file local only. It is gitignored.
