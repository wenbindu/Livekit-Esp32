# Diagnostic preset: capture rendered downlink audio and upload WAV segments
# to device_server over HTTP.

ENABLE_DEBUG_UPLINK_WS=0
ENABLE_DEBUG_DOWNLINK_WS=0
ENABLE_DEBUG_DOWNLINK_HTTP_UPLOAD=1
ENABLE_DEBUG_UPLINK_WAV=0
LOCAL_AUDIO_UPLINK_ONLY=0
DEBUG_DOWNLINK_HTTP_RINGBUF_KB=24
DEBUG_DOWNLINK_HTTP_IDLE_FLUSH_MS=1000
DEBUG_DOWNLINK_HTTP_SEGMENT_SECONDS=8
