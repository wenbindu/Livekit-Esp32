# Copy to configs/token_server.local.env and edit locally.
# This file is intended for the token server runtime only.
# Keep the real configs/token_server.local.env file local only. It is gitignored.

# LiveKit project used by scripts/token_server.py
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# Optional defaults used when the device request does not override them.
LIVEKIT_ROOM=lichuang-room
LIVEKIT_AGENT_NAME=my-agent
# LIVEKIT_AGENT_METADATA={"env":"prod"}

# The launcher script reads bind settings from process environment, for example:
# TOKEN_SERVER_HOST=0.0.0.0
# TOKEN_SERVER_PORT=8790
# TOKEN_SERVER_HTTP_PATH=/token
# TOKEN_SERVER_TTL_SECONDS=3600
# TOKEN_SERVER_PUBLIC_HOST=your.public.ip.or.domain
