# Copy to device_server/configs/device_server.local.env and edit locally.
# This file is intended for the device-server runtime only.
# Keep the real device_server/configs/device_server.local.env local only.
# It is gitignored.

# LiveKit project used by device_server/scripts/device_server.py
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# Optional defaults used when the device request does not override them.
LIVEKIT_ROOM=lichuang-room
LIVEKIT_AGENT_NAME=my-agent
# LIVEKIT_AGENT_METADATA={"env":"prod"}

# The launcher and systemd unit read bind settings from process environment.
# DEVICE_SERVER_* is the primary naming. Legacy TOKEN_SERVER_HOST,
# TOKEN_SERVER_PORT, TOKEN_SERVER_TTL_SECONDS, TOKEN_SERVER_PUBLIC_HOST,
# and TOKEN_SERVER_ENV_FILE are still accepted as compatibility aliases.
# DEVICE_SERVER_HOST=0.0.0.0
# DEVICE_SERVER_PORT=8790
# DEVICE_SERVER_TTL_SECONDS=3600
# DEVICE_SERVER_PUBLIC_HOST=your.public.ip.or.domain
# DEVICE_SERVER_ENV_FILE=/opt/livekit-esp32s3/device_server/configs/device_server.local.env
#
# Runtime storage and limits are configurable:
# DEVICE_SERVER_DATA_DIR=.run/device_server
# DEVICE_SERVER_RUN_DIR=.run
# DEVICE_SERVER_PID_FILE=.run/device_server.pid
# DEVICE_SERVER_LOG_FILE=.run/device_server.log
# DEVICE_SERVER_MAX_EVENT_BYTES=65536
# DEVICE_SERVER_MAX_BLOB_BYTES=1048576
