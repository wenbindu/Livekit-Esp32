# Edit User, Group, WorkingDirectory, EnvironmentFile, ExecStart, and
# ReadWritePaths to match your server path before installing.

[Unit]
Description=LiveKit ESP32-S3 Device Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/opt/livekit-esp32s3/device_server
EnvironmentFile=/opt/livekit-esp32s3/device_server/configs/device_server.local.env
Environment=DEVICE_SERVER_HOST=0.0.0.0
Environment=DEVICE_SERVER_PORT=8790
Environment=DEVICE_SERVER_TTL_SECONDS=3600
Environment=DEVICE_SERVER_DATA_DIR=/opt/livekit-esp32s3/device_server/.run/device_server
ExecStart=/opt/livekit-esp32s3/device_server/scripts/device_server_run.sh
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/livekit-esp32s3/device_server/.run
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
